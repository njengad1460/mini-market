# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/mini-market

# AWS Cognito (Authentication)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# AWS Credentials (Optional, needed for admin Cognito actions and S3 uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=mimi-market
S3_REGION=af-south-1-an
S3_PUBLIC_BASE_URL=arn:aws:s3:::mimi-market-350238019470-af-south-1-an
# AWS S3 (Image storage)
S3_BUCKET_NAME=mimi-market
S3_REGION=af-south-1-an
S3_PUBLIC_BASE_URL=arn:aws:s3:::mimi-market-350238019470-af-south-1-an

# WhatsApp Notifications (Optional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
BUSINESS_WHATSAPP_PHONE=
